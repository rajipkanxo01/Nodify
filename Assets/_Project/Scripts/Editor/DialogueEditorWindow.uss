/* Defines the layout and visual states for the main dialogue authoring window. */

.dialogue-editor {
    flex-grow: 1;
    background-color: rgb(35, 35, 35);
}

.dialogue-header {
    min-height: 72px;
    padding: 12px 16px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    border-bottom-width: 1px;
    border-bottom-color: rgb(58, 58, 58);
}

.dialogue-title-group {
    flex-grow: 1;
}

.dialogue-title {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(235, 235, 235);
}

.dialogue-subtitle {
    margin-top: 2px;
    color: rgb(155, 155, 155);
}

.dialogue-project-field {
    min-width: 300px;
}

.dialogue-header-actions {
    min-width: 350px;
    margin-left: 20px;
    flex-direction: row;
    align-items: flex-end;
}

.dialogue-header-action {
    height: 22px;
    margin-left: 6px;
    padding-left: 12px;
    padding-right: 12px;
}

.dialogue-first-run {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    padding: 32px;
}

.dialogue-first-run-card {
    width: 460px;
    padding: 32px;
    align-items: center;
    border-width: 1px;
    border-color: rgb(62, 62, 62);
    border-radius: 6px;
    background-color: rgb(41, 41, 41);
}

.dialogue-first-run-title {
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(235, 235, 235);
}

.dialogue-first-run-description {
    margin-top: 8px;
    margin-bottom: 20px;
    white-space: normal;
    -unity-text-align: middle-center;
    color: rgb(175, 175, 175);
}

.dialogue-first-run-action {
    height: 34px;
    min-width: 220px;
    padding-left: 18px;
    padding-right: 18px;
    -unity-font-style: bold;
}

.dialogue-tab-bar {
    min-height: 38px;
    padding-left: 12px;
    padding-right: 12px;
    flex-direction: row;
    align-items: flex-end;
    background-color: rgb(42, 42, 42);
    border-bottom-width: 1px;
    border-bottom-color: rgb(62, 62, 62);
}

.dialogue-tab {
    min-width: 92px;
    height: 30px;
    margin-right: 4px;
    border-bottom-width: 2px;
    border-bottom-color: rgba(0, 0, 0, 0);
    background-color: rgba(0, 0, 0, 0);
}

.dialogue-tab:hover {
    background-color: rgb(52, 52, 52);
}

.dialogue-tab--selected {
    border-bottom-color: rgb(79, 155, 235);
    background-color: rgb(48, 48, 48);
    -unity-font-style: bold;
}

.dialogue-content {
    flex-grow: 1;
    padding: 18px;
}

.dialogue-panel-title {
    margin-bottom: 12px;
    font-size: 17px;
    -unity-font-style: bold;
    color: rgb(230, 230, 230);
}

.dialogue-panel {
    padding: 16px;
    border-width: 1px;
    border-color: rgb(62, 62, 62);
    border-radius: 4px;
    background-color: rgb(41, 41, 41);
}

.dialogue-panel-description {
    margin-bottom: 12px;
    font-size: 13px;
    color: rgb(190, 190, 190);
}

.dialogue-empty-state,
.dialogue-coming-soon {
    margin-top: 8px;
}

.dialogue-coming-soon {
    color: rgb(135, 135, 135);
    -unity-font-style: italic;
}
