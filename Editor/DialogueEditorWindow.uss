/* Defines the layout and visual states for the main dialogue authoring window. */

.dialogue-editor {
    flex-grow: 1;
    background-color: rgb(35, 35, 35);
}

.dialogue-header {
    min-height: 72px;
    padding: 12px 16px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    border-bottom-width: 1px;
    border-bottom-color: rgb(58, 58, 58);
}

.dialogue-title-group {
    flex-grow: 1;
}

.dialogue-title {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(235, 235, 235);
}

.dialogue-subtitle {
    margin-top: 2px;
    color: rgb(155, 155, 155);
}

.dialogue-project-field {
    min-width: 300px;
}

.dialogue-header-actions {
    min-width: 350px;
    margin-left: 20px;
    flex-direction: row;
    align-items: flex-end;
}

.dialogue-header-action {
    height: 22px;
    margin-left: 6px;
    padding-left: 12px;
    padding-right: 12px;
}

.dialogue-first-run {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    padding: 32px;
}

.dialogue-first-run-card {
    width: 460px;
    padding: 32px;
    align-items: center;
    border-width: 1px;
    border-color: rgb(62, 62, 62);
    border-radius: 6px;
    background-color: rgb(41, 41, 41);
}

.dialogue-first-run-title {
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(235, 235, 235);
}

.dialogue-first-run-description {
    margin-top: 8px;
    margin-bottom: 20px;
    white-space: normal;
    -unity-text-align: middle-center;
    color: rgb(175, 175, 175);
}

.dialogue-first-run-action {
    height: 34px;
    min-width: 220px;
    padding-left: 18px;
    padding-right: 18px;
    -unity-font-style: bold;
}

.dialogue-tab-bar {
    min-height: 38px;
    padding-left: 12px;
    padding-right: 12px;
    flex-direction: row;
    align-items: flex-end;
    background-color: rgb(42, 42, 42);
    border-bottom-width: 1px;
    border-bottom-color: rgb(62, 62, 62);
}

.dialogue-tab {
    min-width: 92px;
    height: 30px;
    margin-right: 4px;
    border-bottom-width: 2px;
    border-bottom-color: rgba(0, 0, 0, 0);
    background-color: rgba(0, 0, 0, 0);
}

.dialogue-tab:hover {
    background-color: rgb(52, 52, 52);
}

.dialogue-tab--selected {
    border-bottom-color: rgb(79, 155, 235);
    background-color: rgb(48, 48, 48);
    -unity-font-style: bold;
}

.dialogue-content {
    flex-grow: 1;
    padding: 18px;
}

.dialogue-panel-title {
    margin-bottom: 12px;
    font-size: 17px;
    -unity-font-style: bold;
    color: rgb(230, 230, 230);
}

.dialogue-panel {
    padding: 16px;
    border-width: 1px;
    border-color: rgb(62, 62, 62);
    border-radius: 4px;
    background-color: rgb(41, 41, 41);
}

.dialogue-panel-description {
    margin-bottom: 12px;
    font-size: 13px;
    color: rgb(190, 190, 190);
}

.dialogue-empty-state,
.dialogue-coming-soon {
    margin-top: 8px;
}

.dialogue-coming-soon {
    color: rgb(135, 135, 135);
    -unity-font-style: italic;
}

.dialogue-character-toolbar {
    min-height: 30px;
    margin-bottom: 10px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.dialogue-character-search {
    flex-grow: 1;
    margin-right: 10px;
}

.dialogue-primary-action {
    min-width: 124px;
    -unity-font-style: bold;
}

.dialogue-character-split-view {
    min-height: 330px;
    flex-grow: 1;
    flex-direction: row;
    border-top-width: 1px;
    border-top-color: rgb(62, 62, 62);
}

.dialogue-character-list {
    width: 230px;
    min-width: 180px;
    padding-top: 8px;
    padding-right: 8px;
    border-right-width: 1px;
    border-right-color: rgb(62, 62, 62);
}

.dialogue-character-list-empty {
    padding: 14px 8px;
    white-space: normal;
    color: rgb(145, 145, 145);
}

.dialogue-character-list-item {
    min-height: 58px;
    margin-bottom: 5px;
    padding: 6px;
    flex-direction: row;
    align-items: center;
    -unity-text-align: middle-left;
    background-color: rgb(47, 47, 47);
    border-width: 1px;
    border-color: rgb(58, 58, 58);
    border-radius: 3px;
}

.dialogue-character-list-item:hover {
    background-color: rgb(55, 55, 55);
}

.dialogue-character-list-item--selected {
    background-color: rgb(48, 63, 80);
    border-color: rgb(79, 155, 235);
}

.dialogue-character-list-portrait {
    width: 44px;
    height: 44px;
    margin-right: 8px;
    background-color: rgb(31, 31, 31);
}

.dialogue-character-list-text {
    flex-grow: 1;
}

.dialogue-character-list-name {
    margin-bottom: 3px;
    -unity-font-style: bold;
    color: rgb(225, 225, 225);
}

.dialogue-character-warning-badge {
    width: 20px;
    height: 20px;
    border-radius: 10px;
    background-color: rgb(173, 116, 35);
    color: rgb(255, 235, 198);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.dialogue-character-editor {
    min-width: 340px;
    flex-grow: 1;
    padding-top: 10px;
    padding-left: 14px;
}

.dialogue-character-editor-empty {
    margin-top: 10px;
}

.dialogue-character-editor-heading,
.dialogue-expression-heading {
    margin-bottom: 10px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.dialogue-section-title {
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(225, 225, 225);
}

.dialogue-character-usage {
    margin-top: 8px;
    margin-bottom: 18px;
    color: rgb(155, 155, 155);
}

.dialogue-expression-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.dialogue-expression-card {
    width: 220px;
    margin-right: 10px;
    margin-bottom: 10px;
    padding: 9px;
    border-width: 1px;
    border-color: rgb(66, 66, 66);
    border-radius: 4px;
    background-color: rgb(46, 46, 46);
}

.dialogue-expression-card--default {
    border-color: rgb(79, 155, 235);
}

.dialogue-expression-preview {
    height: 130px;
    margin-bottom: 8px;
    background-color: rgb(30, 30, 30);
}

.dialogue-expression-actions {
    min-height: 25px;
    margin-top: 7px;
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
}

.dialogue-expression-actions > Button {
    margin-left: 4px;
}

.dialogue-default-expression-label {
    flex-grow: 1;
    color: rgb(104, 175, 245);
    -unity-font-style: bold;
}

.dialogue-inline-warning {
    margin-top: 4px;
    color: rgb(230, 167, 79);
}

.dialogue-optional-hint {
    margin-top: 4px;
    color: rgb(140, 140, 140);
    -unity-font-style: italic;
}

.dialogue-character-danger-actions {
    margin-top: 16px;
    padding-top: 12px;
    flex-direction: row;
    justify-content: flex-end;
    border-top-width: 1px;
    border-top-color: rgb(62, 62, 62);
}

.dialogue-character-danger-actions > Button {
    margin-left: 6px;
}

.dialogue-danger-action {
    color: rgb(255, 175, 175);
}

/* Characters tab: compact sidebar and constrained editing workspace. */

.dialogue-character-split-view {
    min-height: 430px;
    border-top-width: 0;
}

.dialogue-character-sidebar {
    width: 260px;
    min-width: 220px;
    padding-right: 12px;
    border-right-width: 1px;
    border-right-color: rgb(68, 68, 68);
}

.dialogue-character-sidebar-header {
    min-height: 30px;
    margin-bottom: 6px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.dialogue-character-sidebar-title {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(220, 220, 220);
}

.dialogue-character-sidebar .dialogue-primary-action {
    width: 28px;
    min-width: 28px;
    height: 22px;
    padding-left: 0;
    padding-right: 0;
    font-size: 15px;
}

.dialogue-character-sidebar .dialogue-character-search {
    width: 100%;
    max-width: 248px;
    min-width: 0;
    margin-right: 0;
    margin-bottom: 8px;
    flex-grow: 0;
    flex-shrink: 1;
    align-self: stretch;
}

.dialogue-character-sidebar .dialogue-character-list {
    width: auto;
    min-width: 0;
    flex-grow: 1;
    padding-top: 0;
    padding-right: 0;
    border-right-width: 0;
}

.dialogue-character-list-item {
    min-height: 52px;
    margin-bottom: 4px;
    padding: 5px;
}

.dialogue-character-list-portrait {
    width: 40px;
    height: 40px;
}

.dialogue-character-editor {
    padding-top: 0;
    padding-left: 18px;
    padding-right: 8px;
}

.dialogue-character-editor-content {
    max-width: 980px;
    padding-bottom: 18px;
}

.dialogue-character-details-panel {
    max-width: 820px;
    padding: 14px;
    border-width: 1px;
    border-color: rgb(61, 61, 61);
    border-radius: 4px;
    background-color: rgb(45, 45, 45);
}

.dialogue-character-editor-heading {
    min-height: 26px;
    margin-bottom: 12px;
}

.dialogue-character-heading-actions {
    flex-direction: row;
    align-items: center;
}

.dialogue-character-heading-actions > * {
    margin-left: 5px;
}

.dialogue-character-usage-badge {
    min-height: 20px;
    padding: 2px 8px;
    border-radius: 10px;
    background-color: rgb(56, 56, 56);
    color: rgb(165, 165, 165);
    -unity-text-align: middle-center;
}

.dialogue-character-technical-fields {
    margin-top: 10px;
    margin-bottom: 10px;
    padding: 9px;
    border-left-width: 2px;
    border-left-color: rgb(75, 75, 75);
    background-color: rgb(40, 40, 40);
}

.dialogue-technical-label {
    margin-bottom: 5px;
    font-size: 11px;
    color: rgb(135, 135, 135);
    -unity-font-style: bold;
}

.dialogue-expression-heading {
    max-width: 820px;
    margin-top: 22px;
    margin-bottom: 10px;
}

.dialogue-expression-grid {
    max-width: 980px;
}

.dialogue-expression-card {
    width: 190px;
    margin-right: 8px;
    margin-bottom: 8px;
    padding: 8px;
}

.dialogue-expression-preview {
    height: 145px;
    border-width: 1px;
    border-color: rgb(57, 57, 57);
}

.dialogue-expression-field-label {
    margin-bottom: 3px;
    font-size: 11px;
    color: rgb(150, 150, 150);
}

.dialogue-expression-actions {
    margin-top: 6px;
}

.dialogue-overflow-action {
    width: 30px;
    min-width: 30px;
    padding-left: 3px;
    padding-right: 3px;
    -unity-font-style: bold;
}

/* Project overview dashboard. */

.dialogue-project-scroll-view {
    min-height: 430px;
    flex-grow: 1;
}

.dialogue-project-dashboard {
    max-width: 980px;
    padding-right: 8px;
    padding-bottom: 18px;
}

.dialogue-project-card,
.dialogue-project-section {
    margin-bottom: 14px;
    padding: 14px;
    border-width: 1px;
    border-color: rgb(61, 61, 61);
    border-radius: 4px;
    background-color: rgb(45, 45, 45);
}

.dialogue-project-section-header {
    min-height: 30px;
    margin-bottom: 12px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.dialogue-project-section-subtitle {
    margin-top: 2px;
    color: rgb(145, 145, 145);
}

.dialogue-project-asset-row {
    flex-direction: row;
    align-items: flex-end;
}

.dialogue-project-asset-path {
    flex-grow: 1;
    margin-right: 6px;
}

.dialogue-project-stats {
    margin-top: 10px;
    flex-direction: row;
    flex-wrap: wrap;
}

.dialogue-project-stat-card {
    width: 150px;
    height: 76px;
    margin-right: 8px;
    margin-bottom: 8px;
    padding: 8px 12px;
    align-items: flex-start;
    justify-content: center;
    border-width: 1px;
    border-color: rgb(62, 62, 62);
    border-radius: 4px;
    background-color: rgb(49, 49, 49);
}

.dialogue-project-stat-card:hover {
    background-color: rgb(56, 56, 56);
    border-color: rgb(79, 125, 175);
}

.dialogue-project-stat-card--warning {
    border-color: rgb(170, 112, 45);
}

.dialogue-project-stat-value {
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(230, 230, 230);
}

.dialogue-project-stat-title {
    margin-top: 2px;
    color: rgb(155, 155, 155);
}

.dialogue-project-quick-actions {
    margin-top: 10px;
    flex-direction: row;
    flex-wrap: wrap;
}

.dialogue-project-quick-actions > Button {
    min-width: 130px;
    margin-right: 6px;
    margin-bottom: 6px;
}

.dialogue-project-health-list {
    border-top-width: 1px;
    border-top-color: rgb(58, 58, 58);
}

.dialogue-project-health-row {
    min-height: 30px;
    padding-top: 6px;
    padding-bottom: 6px;
    flex-direction: row;
    align-items: center;
    border-bottom-width: 1px;
    border-bottom-color: rgb(55, 55, 55);
    color: rgb(180, 180, 180);
}

.dialogue-project-health-row--warning {
    color: rgb(225, 170, 94);
}

.dialogue-project-health-icon {
    width: 24px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* Conversations tab: list, passage graph, and inspector. */

.dialogue-conversation-workspace {
    min-height: 520px;
    flex-grow: 1;
    flex-direction: row;
    border-top-width: 1px;
    border-top-color: rgb(61, 61, 61);
}

.dialogue-conversation-sidebar {
    width: 240px;
    min-width: 200px;
    padding-top: 10px;
    padding-right: 10px;
    border-right-width: 1px;
    border-right-color: rgb(64, 64, 64);
}

.dialogue-conversation-sidebar-header,
.dialogue-conversation-inspector-header,
.dialogue-conversation-element-header,
.dialogue-conversation-graph-toolbar {
    min-height: 28px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.dialogue-conversation-sidebar-header {
    margin-bottom: 6px;
}

.dialogue-conversation-sidebar-header > Button {
    width: 28px;
    min-width: 28px;
}

.dialogue-conversation-search {
    width: 100%;
    max-width: 230px;
    min-width: 0;
    margin-bottom: 8px;
    flex-shrink: 1;
}

.dialogue-conversation-list {
    flex-grow: 1;
}

.dialogue-conversation-group {
    margin-bottom: 5px;
}

.dialogue-conversation-group-header {
    min-height: 34px;
    padding: 5px 6px;
    flex-direction: row;
    align-items: center;
    -unity-text-align: middle-left;
    border-width: 1px;
    border-color: rgb(57, 60, 65);
    border-radius: 3px;
    background-color: rgb(45, 47, 51);
}

.dialogue-conversation-group-header:hover {
    background-color: rgb(52, 55, 60);
}

.dialogue-conversation-group-header > .dialogue-character-list-name {
    flex-grow: 1;
}

.dialogue-conversation-group-chevron {
    width: 17px;
    min-width: 17px;
    color: rgb(174, 180, 188);
    -unity-text-align: middle-left;
}

.dialogue-conversation-group-count {
    min-width: 21px;
    margin-left: 5px;
    padding: 1px 5px;
    border-radius: 8px;
    background-color: rgb(60, 63, 69);
    color: rgb(170, 174, 181);
    font-size: 10px;
    -unity-text-align: middle-center;
}

.dialogue-conversation-passage-list {
    margin-left: 10px;
    padding-top: 2px;
    padding-left: 5px;
    border-left-width: 1px;
    border-left-color: rgb(65, 68, 74);
}

.dialogue-conversation-passage-item {
    min-height: 27px;
    margin-top: 1px;
    padding: 3px 6px;
    flex-direction: row;
    align-items: center;
    -unity-text-align: middle-left;
    border-width: 0;
    border-radius: 3px;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(193, 196, 202);
}

.dialogue-conversation-passage-item:hover {
    background-color: rgb(48, 51, 56);
}

.dialogue-conversation-passage-item--selected {
    background-color: rgb(45, 66, 88);
    color: rgb(222, 234, 247);
}

.dialogue-conversation-passage-icon {
    width: 18px;
    min-width: 18px;
    margin-right: 2px;
    color: rgb(126, 162, 200);
    -unity-text-align: middle-center;
}

.dialogue-conversation-list-item {
    min-height: 48px;
    margin-bottom: 4px;
    padding: 6px 8px;
    flex-direction: row;
    align-items: center;
    -unity-text-align: middle-left;
    border-width: 1px;
    border-color: rgb(57, 57, 57);
    border-radius: 3px;
    background-color: rgb(47, 47, 47);
}

.dialogue-conversation-list-item:hover {
    background-color: rgb(55, 55, 55);
}

.dialogue-conversation-list-item--selected {
    border-color: rgb(79, 155, 235);
    background-color: rgb(48, 63, 80);
}

.dialogue-conversation-graph-host {
    min-width: 380px;
    flex-grow: 1;
}

.dialogue-conversation-graph-toolbar {
    height: 38px;
    padding-left: 10px;
    padding-right: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(61, 61, 61);
    background-color: rgb(43, 43, 43);
}

.dialogue-conversation-graph-toolbar Button {
    margin-left: 4px;
}

.dialogue-conversation-title-field {
    width: 240px;
    max-width: 40%;
    -unity-font-style: bold;
}

.dialogue-conversation-graph {
    flex-grow: 1;
    background-color: rgb(31, 31, 31);
}

.dialogue-conversation-node-preview {
    max-width: 190px;
    padding: 5px;
    white-space: normal;
    color: rgb(165, 165, 165);
}

.dialogue-conversation-inline-node {
    min-width: 420px;
    max-width: 420px;
    border-radius: 7px;
    border-color: rgb(67, 76, 88);
    background-color: rgb(31, 33, 37);
}

.dialogue-conversation-inline-header {
    min-height: 40px;
    padding-left: 7px;
    padding-right: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(70, 81, 94);
    background-color: rgb(47, 54, 63);
}

.dialogue-conversation-inline-content {
    padding-top: 5px;
    background-color: rgb(34, 36, 40);
}

.dialogue-conversation-inline-title {
    min-width: 190px;
    flex-grow: 1;
    margin-left: 7px;
    margin-right: 6px;
    font-size: 13px;
    padding: 1px 3px;
    border-width: 1px;
    border-color: rgb(67, 72, 80);
    border-radius: 3px;
    background-color: rgb(39, 42, 47);
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.dialogue-conversation-inline-title .unity-text-input,
.dialogue-conversation-inline-title .unity-text-field__input {
    padding-left: 5px;
    border-width: 0;
    background-image: none;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(232, 234, 238);
    -unity-text-align: middle-left;
}

.dialogue-conversation-inline-start-badge {
    margin-left: 4px;
    padding: 2px 6px;
    border-radius: 3px;
    background-color: rgb(50, 112, 78);
    color: rgb(205, 241, 218);
    font-size: 9px;
    -unity-font-style: bold;
}

.dialogue-conversation-inline-warning-badge {
    width: 18px;
    height: 18px;
    margin-left: 3px;
    border-radius: 9px;
    background-color: rgb(142, 94, 35);
    color: rgb(255, 226, 172);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

.dialogue-conversation-inline-input {
    margin-left: 1px;
    margin-right: 3px;
}

.dialogue-conversation-inline-output {
    margin-left: 3px;
    margin-right: 1px;
}

.dialogue-conversation-inline-line {
    margin: 3px 8px;
    padding: 7px 8px;
    flex-direction: row;
    align-items: flex-start;
    border-width: 1px;
    border-color: rgb(57, 61, 68);
    border-radius: 3px;
    background-color: rgb(40, 42, 47);
}

.dialogue-conversation-inline-line:hover {
    border-color: rgb(72, 82, 95);
    background-color: rgb(44, 47, 53);
}

.dialogue-conversation-inline-line--active {
    border-color: rgb(77, 137, 199);
    background-color: rgb(42, 49, 58);
}

.dialogue-conversation-inline-line-actions {
    display: none;
    margin-left: 4px;
    flex-direction: row;
}

.dialogue-conversation-inline-line:hover .dialogue-conversation-inline-line-actions,
.dialogue-conversation-inline-line--active .dialogue-conversation-inline-line-actions {
    display: flex;
}

.dialogue-conversation-inline-line-actions > Button {
    width: 21px;
    min-width: 21px;
    height: 21px;
    margin-left: 2px;
    padding: 0;
}

.dialogue-conversation-inline-body {
    min-width: 0;
    flex-grow: 1;
}

.dialogue-conversation-inline-speaker-row {
    min-height: 21px;
    margin-bottom: 1px;
    flex-direction: row;
    align-items: center;
}

.dialogue-conversation-inline-avatar {
    width: 40px;
    height: 40px;
    min-width: 40px;
    margin-right: 8px;
    border-width: 1px;
    border-color: rgb(76, 83, 94);
    border-radius: 4px;
    background-color: rgb(52, 61, 73);
    -unity-background-scale-mode: scale-and-crop;
    overflow: hidden;
}

.dialogue-conversation-inline-avatar > Label {
    flex-grow: 1;
    color: rgb(193, 211, 233);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

.dialogue-conversation-inline-speaker {
    min-width: 145px;
    flex-grow: 1;
    margin-right: 4px;
    font-size: 11px;
    -unity-font-style: bold;
}

.dialogue-conversation-inline-speaker .unity-base-popup-field__input,
.dialogue-conversation-inline-speaker .unity-popup-field__input {
    padding-left: 2px;
    border-width: 0;
    background-image: none;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(235, 236, 239);
}

.dialogue-conversation-inline-expression {
    width: 118px;
    color: rgb(162, 166, 173);
}

.dialogue-conversation-inline-expression-group {
    min-width: 30px;
    align-items: flex-end;
}

.dialogue-conversation-inline-expression-toggle {
    min-width: 28px;
    height: 24px;
    padding-left: 5px;
    padding-right: 5px;
    color: rgb(162, 177, 194);
}

.dialogue-conversation-inline-text {
    min-height: 32px;
    margin-top: 2px;
    padding: 2px 4px;
    border-width: 1px;
    border-color: rgb(55, 59, 66);
    border-radius: 3px;
    background-color: rgb(35, 37, 41);
    white-space: normal;
}

.dialogue-conversation-inline-text .unity-text-input,
.dialogue-conversation-inline-text .unity-text-field__input {
    padding: 2px;
    border-width: 0;
    background-image: none;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(218, 220, 224);
    font-size: 12px;
    white-space: normal;
}

.dialogue-conversation-inline-choice-group {
    margin: 5px 8px;
    border-width: 1px;
    border-color: rgb(65, 104, 151);
    border-radius: 4px;
    background-color: rgb(37, 49, 64);
    overflow: hidden;
}

.dialogue-conversation-inline-choice {
    min-height: 34px;
    margin: 0;
    padding: 4px 1px 4px 6px;
    flex-direction: row;
    align-items: center;
    border-width: 0;
    border-bottom-width: 1px;
    border-bottom-color: rgb(55, 80, 109);
    background-color: rgba(0, 0, 0, 0);
}

.dialogue-conversation-inline-choice:hover {
    background-color: rgb(42, 59, 78);
}

.dialogue-conversation-inline-choice--last {
    border-bottom-width: 0;
}

.dialogue-conversation-inline-choice > TextField {
    flex-grow: 1;
}

.dialogue-conversation-inline-choice > TextField .unity-text-input {
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(213, 227, 244);
}

.dialogue-conversation-inline-choice-icon {
    width: 20px;
    min-width: 20px;
    color: rgb(113, 174, 238);
    font-size: 18px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

.dialogue-conversation-inline-choice > Button {
    width: 25px;
    min-width: 25px;
    margin-left: 4px;
    padding-left: 2px;
    padding-right: 2px;
}

.dialogue-conversation-inline-choice-actions {
    margin-left: 3px;
    flex-direction: row;
}

.dialogue-conversation-inline-choice-actions > Button {
    width: 21px;
    min-width: 21px;
    height: 22px;
    margin-left: 2px;
    padding: 0;
}

.dialogue-conversation-inline-actions {
    margin: 7px 8px 0 8px;
    padding-top: 7px;
    padding-bottom: 8px;
    padding-right: 1px;
    flex-direction: row;
    justify-content: flex-end;
    border-top-width: 1px;
    border-top-color: rgb(57, 61, 68);
    background-color: rgb(34, 36, 40);
}

.dialogue-conversation-inline-actions > Button {
    margin-left: 4px;
    padding-left: 9px;
    padding-right: 9px;
}

.dialogue-conversation-inline-end-action {
    margin-left: 0;
    color: rgb(207, 169, 128);
}

.dialogue-conversation-inline-end-action:disabled {
    color: rgb(133, 165, 143);
}

.dialogue-conversation-inspector {
    width: 360px;
    min-width: 300px;
    padding: 12px;
    border-left-width: 1px;
    border-left-color: rgb(64, 64, 64);
    background-color: rgb(39, 39, 39);
}

.dialogue-conversation-inspector-header {
    margin-bottom: 10px;
}

.dialogue-conversation-inspector-divider {
    height: 1px;
    margin-top: 14px;
    margin-bottom: 14px;
    background-color: rgb(65, 65, 65);
}

.dialogue-conversation-element-card {
    margin-bottom: 8px;
    padding: 9px;
    border-width: 1px;
    border-color: rgb(64, 64, 64);
    border-radius: 4px;
    background-color: rgb(46, 46, 46);
}

.dialogue-conversation-element-header {
    margin-bottom: 7px;
}

.dialogue-conversation-element-header Button {
    width: 26px;
    min-width: 26px;
    margin-left: 3px;
    padding-left: 2px;
    padding-right: 2px;
}

.dialogue-conversation-element-title {
    -unity-font-style: bold;
    color: rgb(215, 215, 215);
}

.dialogue-conversation-choice-option {
    margin-bottom: 7px;
    padding: 7px;
    border-left-width: 2px;
    border-left-color: rgb(79, 125, 175);
    background-color: rgb(41, 41, 41);
}

.dialogue-conversation-structured-editor {
    margin-top: 2px;
}
